{
  "_comment": [
    "DatabaseTable connector -> Databricks inbound table (spike; docs/plan.md).",
    "Adapted from shipped example-configurations/provisioners/provisioner.openicf-contractordb.json.",
    "Secrets via &{} substitution — define databricks.host/httppath/pat in",
    "runtime resolver/boot.properties (values from secrets/databricks.env).",
    "SPIKE-VERIFY: (a) username/password props reaching driver as UID/PWD;",
    "(b) table resolution via ConnCatalog/ConnSchema in URL vs 'table' prop;",
    "(c) paging — set disablePaging true if generated paging SQL fails."
  ],
  "connectorRef": {
    "bundleName": "org.forgerock.openicf.connectors.databasetable-connector",
    "bundleVersion": "[1.5.0.0,1.6.0.0)",
    "connectorName": "org.identityconnectors.databasetable.DatabaseTableConnector"
  },
  "resultsHandlerConfig": {
    "enableNormalizingResultsHandler": true,
    "enableFilteredResultsHandler": false,
    "enableCaseInsensitiveFilter": false,
    "enableAttributesToGetSearchResultsHandler": true
  },
  "configurationProperties": {
    "url": "jdbc:databricks://&{databricks.host}:443/default;transportMode=http;ssl=1;httpPath=&{databricks.httppath};AuthMech=3;ConnSchema=idm_lab",
    "driverClassName": "com.databricks.client.jdbc.Driver",
    "username": "token",
    "password": "&{databricks.pat}",
    "table": "business_records",
    "keyColumn": "record_id",
    "passwordColumn": "",
    "changeLogColumn": "last_modified",
    "disablePaging": false,
    "enableEmptyString": false,
    "quoting": "",
    "rethrowAllSQLExceptions": true,
    "nativeTimestamps": true,
    "allNative": false,
    "suppressPassword": true,
    "validationQuery": "SELECT 1",
    "validationQueryTimeout": -1,
    "validationInterval": 3000,
    "initialSize": 1,
    "minIdle": 0,
    "maxIdle": 2,
    "maxActive": 4,
    "maxWait": 30000,
    "maxAge": 0,
    "minEvictableIdleTimeMillis": 60000,
    "timeBetweenEvictionRunsMillis": 5000,
    "testWhileIdle": false,
    "testOnBorrow": true
  },
  "syncFailureHandler": {
    "maxRetries": 5,
    "postRetryAction": "logged-ignore"
  },
  "objectTypes": {
    "account": {
      "$schema": "http://json-schema.org/draft-03/schema",
      "id": "account",
      "type": "object",
      "nativeType": "__ACCOUNT__",
      "properties": {
        "record_id": { "type": "string", "nativeName": "__NAME__", "nativeType": "string", "required": true },
        "ref_id": { "type": "string", "nativeName": "ref_id", "nativeType": "string" },
        "last_modified": { "type": "string", "nativeName": "last_modified", "nativeType": "string" }
      }
    }
  }
}
