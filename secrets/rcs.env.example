# Copy to secrets/rcs.env and fill in. The real file is gitignored.
# Letters and digits only for all values (they pass through shell/JVM options).

# Client mode (the target): one IDM login per connector server (Ping's
# recommendation). Each server <name> logs in as <name>-client with
# RCS_IDM_PASSWORD_<NAME>; idm-config/deploy.sh gives IDM the same value.
# Used by rcs/run.sh (rcslocal) and rcs/k8s/deploy.sh (databricks0/1).
RCS_IDM_PASSWORD_RCSLOCAL=<random-alphanumeric>
RCS_IDM_PASSWORD_DATABRICKS0=<random-alphanumeric>
RCS_IDM_PASSWORD_DATABRICKS1=<random-alphanumeric>

# Server mode (stepping stone only): shared key, set on the RCS by
# `rcs/deploy.sh server` via /setKey and given to IDM as &{rcs.key} by
# `idm-config/deploy.sh rcs`.
RCS_KEY=<random-alphanumeric>
