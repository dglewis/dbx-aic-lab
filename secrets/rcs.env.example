# Copy to secrets/rcs.env and fill in. The real file is gitignored.

# Server-mode shared key (topology T1): set on the RCS by rcs/deploy.sh via
# `ConnectorServer.sh /setKey`, and given to IDM as &{rcs.key} by
# `idm-config/deploy.sh rcs`. Letters and digits only (no shell metacharacters).
RCS_KEY=<random-alphanumeric>
