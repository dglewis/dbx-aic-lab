# Copy to secrets/databricks.env and fill in. The real file is gitignored.
# Shell-sourced by the lab scripts — any value containing ';' MUST be
# double-quoted or sourcing truncates it at the first semicolon (this
# masquerades as JDBC driver error 500177 "Error getting http path").

# Workspace hostname (Databricks: Compute → SQL Warehouses → Connection details)
DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com

# Warehouse HTTP path (same page)
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# Workspace OIDC issuer (token endpoint is <this>/v1/token)
DATABRICKS_OAUTH_URL=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com/oidc

# JDBC URL — no path segment after the port.
# Leave auth params out: M2M params are appended in code (connector
# customizer, JdbcRunner). Only if you use the optional PAT instead, add
# ;AuthMech=3 to this URL.
DATABRICKS_JDBC_URL="jdbc:databricks://dbc-xxxxxxxx-xxxx.cloud.databricks.com:443;transportMode=http;ssl=1;httpPath=/sql/1.0/warehouses/<warehouse-id>"

DATABRICKS_WORKSPACE_ID=<workspace-id>

# Service principal — the authentication method (OAuth M2M; ADR-002).
# Workspace Settings → Identity and access → Service principals → your SP →
# Secrets → Generate secret.
DATABRICKS_SP_CLIENT_ID=<application-id-uuid>
DATABRICKS_SP_CLIENT_SECRET=<oauth-secret>

# OPTIONAL personal access token — an alternative credential for tooling
# that accepts one; never required, never used by the connector.
# Leave commented out unless you choose to use it; keep the lifetime short.
# DATABRICKS_PAT=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
